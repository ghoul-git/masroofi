SECRET_KEY=your_secret_key
DEBUG=True
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
# Alternative to the DB_* variables, used instead of them when set (most hosts provide it):
# postgres://user:password@host:5432/name
DATABASE_URL=
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna

# Production (only used when DEBUG=False). Comma-separated lists.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# AI usage limits. Staff users are exempt from the per-user limits.
FREE_RECEIPTS_PER_MONTH=30
FREE_CHAT_PER_DAY=20
GLOBAL_DAILY_AI_CALLS=500

# Versions of the legal texts. Changing one asks every user to accept again.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# Bill-payment platforms (comma-separated). Leave empty for the default list.
PAYMENT_PLATFORMS=

# OpenAI prices in USD per million tokens (evaluation report cost estimates).
OPENAI_INPUT_PRICE_PER_M=0.10
OPENAI_OUTPUT_PRICE_PER_M=0.50

# Speed: reasoning effort per OpenAI call (none/minimal/low/medium/high, or off to not send it)
# and the longest side in pixels a receipt photo is downscaled to before OCR.
OPENAI_EXTRACTION_REASONING=none
OPENAI_AGENT_REASONING=low
OCR_MAX_SIDE=1280
