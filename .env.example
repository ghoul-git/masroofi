SECRET_KEY=your_secret_key
DEBUG=True
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna

# Production (only used when DEBUG=False). Comma-separated lists.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# AI usage limits. Staff users are exempt from the per-user limits.
FREE_RECEIPTS_PER_MONTH=30
FREE_CHAT_PER_DAY=20
GLOBAL_DAILY_AI_CALLS=500

# Versions of the legal texts. Changing one asks every user to accept again.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
